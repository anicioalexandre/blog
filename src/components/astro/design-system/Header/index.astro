---
import { CV_DOCUMENT, GITHUB_PROFILE, LINKEDIN_PROFILE } from 'constants/links'

import ThemeToggle from '../ThemeToggle/index.astro'
import { Image } from 'astro:assets'
---

<header class="pointer-events-none sticky left-0 top-0 z-20 flex w-full justify-center">
  <div
    id="header-container"
    class="pointer-events-auto flex w-full max-w-6xl flex-[0] items-center justify-center gap-3 px-4 py-2 md:flex-1 md:justify-between md:p-3"
  >
    <h1
      class="prose-h3 flex justify-center text-center text-object-high md:prose-h2 md:justify-start md:text-start"
    >
      <a href="/" class="text-inherit no-underline">aa dev</a>
    </h1>
    <nav class="w-fit">
      <ul class="flex items-center justify-center space-x-2">
        <li class="flex items-center">
          <a href="/blog" class="nav-key">
            <Image src="/images/blog-icon.svg" alt="" width={28} height={28} class="nav-icon" />
            <span class="nav-text">Blog</span>
          </a>
        </li>
        <li class="flex items-center">
          <button type="button" data-open-dialog="cv-dialog" class="nav-key" aria-haspopup="dialog">
            <Image src="/images/cv-icon.svg" alt="" width={28} height={28} class="nav-icon" />
            <span class="nav-text">Curriculum</span>
          </button>
        </li>
        <li class="flex items-center">
          <button
            type="button"
            data-open-dialog="links-dialog"
            class="nav-key"
            aria-haspopup="dialog"
          >
            <Image src="/images/clip-icon.svg" alt="" width={28} height={28} class="nav-icon" />
            <span class="nav-text">Links</span>
          </button>
        </li>
        <li class="flex items-center">
          <ThemeToggle />
        </li>
      </ul>
    </nav>
  </div>
</header>
<div id="scroll-trigger"></div>

<dialog
  id="links-dialog"
  class="m-auto w-72 rounded-none border-2 border-ink bg-surface-default p-0 shadow-retro backdrop:bg-black-main/60"
>
  <div class="flex items-center justify-between border-b-2 border-ink bg-primary-main px-3 py-2">
    <span class="text-base font-semibold text-object-contrast">Links</span>
    <button
      type="button"
      data-close-dialog
      aria-label="Close"
      class="win-bevel flex h-6 w-6 items-center justify-center text-sm font-bold leading-none text-object-high"
    >
      &times;
    </button>
  </div>
  <div class="grid gap-3 p-4">
    <a href={GITHUB_PROFILE} target="_blank" rel="noopener noreferrer" class="dialog-link">
      <Image src="/images/github-icon.svg" alt="" width={28} height={28} />
      <span>GitHub</span>
    </a>
    <a href={LINKEDIN_PROFILE} target="_blank" rel="noopener noreferrer" class="dialog-link">
      <Image src="/images/linkedin-icon.svg" alt="" width={28} height={28} />
      <span>LinkedIn</span>
    </a>
  </div>
</dialog>

<dialog
  id="cv-dialog"
  class="m-auto w-72 rounded-none border-2 border-ink bg-surface-default p-0 shadow-retro backdrop:bg-black-main/60"
>
  <div class="flex items-center justify-between border-b-2 border-ink bg-primary-main px-3 py-2">
    <span class="text-base font-semibold text-object-contrast">Curriculum</span>
    <button
      type="button"
      data-close-dialog
      aria-label="Close"
      class="win-bevel flex h-6 w-6 items-center justify-center text-sm font-bold leading-none text-object-high"
    >
      &times;
    </button>
  </div>
  <div class="grid p-4">
    <a href={CV_DOCUMENT} target="_blank" rel="noopener noreferrer" class="dialog-cta">
      Open curriculum (PDF) →
    </a>
  </div>
</dialog>

<style>
  /* Mobile: icon-only 32x32 squares. Desktop: text-only keys, no icons.
     Offset hard shadow like the framed cards; press moves diagonally. */
  .nav-key {
    @apply flex h-8 w-8 shrink-0 select-none items-center justify-center gap-1 border-2 border-ink bg-surface-default px-0 text-sm font-bold text-object-high no-underline shadow-retro-sm transition-none md:w-auto md:px-3;
  }
  .nav-key:hover {
    @apply bg-surface-active;
  }
  .nav-key:active {
    @apply translate-x-[2px] translate-y-[2px] shadow-none;
  }

  /* Pin the icon size — inside the scroll-collapsed flex container, an
     unpinned img (preflight max-width:100%) shrinks to zero. */
  img.nav-icon {
    @apply h-6 w-6 max-w-none shrink-0 md:hidden;
  }

  span.nav-text {
    @apply hidden md:block;
  }

  /* Scrolled state: the wordmark detaches into a hard paper chip — no blur,
     no bounce. Paper-layer motion: quick ease-out. */
  header h1 a {
    @apply rounded-none border-2 border-transparent p-1;
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out,
      box-shadow 150ms ease-out;
  }
  header.scrolling-header h1 a {
    @apply border-ink bg-surface-default shadow-retro-sm;
  }

  div#header-container {
    transition: flex 150ms ease-out;
  }
  header.scrolling-header div#header-container {
    @apply flex-[0];
  }

  a.dialog-link {
    @apply flex items-center gap-2 border-2 border-ink bg-surface-background px-3 py-2 text-base font-bold text-object-high no-underline shadow-retro-sm transition-none hover:bg-surface-active active:translate-x-[2px] active:translate-y-[2px] active:shadow-none;
  }

  a.dialog-cta {
    @apply flex items-center justify-center gap-1 border-2 border-ink bg-primary-main px-3 py-2 text-base font-bold text-object-contrast no-underline shadow-retro-sm transition-none hover:bg-primary-low active:translate-x-[2px] active:translate-y-[2px] active:shadow-none;
  }

  header h1 a {
    @apply flex h-[60px] w-[134px] items-center justify-center;
  }
</style>

<script>
  const transitionBoundary = 30

  const onScroll = () => {
    const headerElement = document.querySelector('header')
    const scrollTriggerElement = document.querySelector('#scroll-trigger')
    if (!headerElement || !scrollTriggerElement) return
    const rect = scrollTriggerElement.getBoundingClientRect()
    headerElement.classList.toggle('scrolling-header', rect.top <= transitionBoundary)
  }

  window.addEventListener('scroll', onScroll, { passive: true })
  document.addEventListener('astro:page-load', onScroll)

  // Any element with data-open-dialog="<id>" opens that dialog; anything
  // inside a dialog with data-close-dialog closes it. Backdrop click closes.
  const bindDialogs = () => {
    document.querySelectorAll<HTMLElement>('[data-open-dialog]').forEach((opener) => {
      if (opener.dataset.bound === 'true') return
      opener.dataset.bound = 'true'
      opener.addEventListener('click', () => {
        const dialog = document.getElementById(opener.dataset.openDialog ?? '')
        if (dialog instanceof HTMLDialogElement) dialog.showModal()
      })
    })
    document.querySelectorAll('dialog').forEach((dialog) => {
      if (dialog.dataset.bound === 'true') return
      dialog.dataset.bound = 'true'
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close()
      })
      dialog.querySelectorAll('[data-close-dialog]').forEach((closeButton) => {
        closeButton.addEventListener('click', () => dialog.close())
      })
      // Dialog links open in a new tab — close the dialog so it isn't
      // still sitting open when the reader comes back.
      dialog.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => dialog.close())
      })
    })
  }
  document.addEventListener('astro:page-load', bindDialogs)
</script>
