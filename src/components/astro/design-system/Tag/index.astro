---
import { cls } from 'utils/string'

interface Props extends astroHTML.JSX.AnchorHTMLAttributes {}
const { class: customClass, ...props } = Astro.props
---

<span
  class={cls(
    'grid items-center justify-center prose-overline rounded-none border border-ink bg-primary-main px-1 text-center text-object-contrast',
    customClass ?? '',
  )}
  {...props}
>
  <slot />
</span>
