---
import { cls } from 'utils/string'

interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  isMdx?: boolean
  isButton?: boolean
}
const { class: customClass = '', rel: customRel, isMdx, isButton, ...props } = Astro.props

const isExternalLink = (href: astroHTML.JSX.AnchorHTMLAttributes['href']) => {
  try {
    if (!href) return false
    const link = new URL(href)
    return link.origin !== Astro.url.origin
  } catch {
    return false
  }
}

const externalLink = isExternalLink(props.href)
const rel = externalLink ? 'noopener noreferrer' : undefined
const target = externalLink ? '_blank' : undefined

// Prose links: always underlined, marker-highlight on hover.
// Nav/UI links: quiet — no underline, amber on hover.
// isButton: paper 3D key, same construction as the Button primitive.
const linkStyles = isMdx
  ? 'prose-button inline-block text-primary-high underline decoration-2 underline-offset-2 transition-colors duration-150 ease-out hover:bg-primary-main hover:text-object-contrast hover:no-underline'
  : 'prose-button inline-block no-underline transition-colors duration-150 ease-out hover:text-primary-high'

const buttonStyles =
  'inline-flex h-8 select-none items-center gap-1 rounded-none border-2 border-ink bg-surface-default px-3 text-xs font-bold text-object-high no-underline shadow-retro-sm transition-none hover:bg-surface-active focus-visible:outline-dotted focus-visible:outline-1 focus-visible:outline-offset-[-4px] focus-visible:outline-ink active:translate-x-[2px] active:translate-y-[2px] active:shadow-none'
---

<a
  class={cls(isButton ? buttonStyles : linkStyles, customClass ?? '')}
  rel={cls(rel ?? '', customRel ?? '')}
  target={target}
  {...props}
>
  <slot />
</a>
